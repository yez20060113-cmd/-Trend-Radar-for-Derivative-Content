# 密钥模板。复制成 .env 再填真实值。
# .env 已在 .gitignore 里，不会入库；本文件可以安全提交。

# ---- 模型层（可选）-----------------------------------------------------
# 用途：L2 素材理解 + 文案可用性评估。
# 任何 OpenAI 兼容服务都行（DeepSeek / OpenAI / 硅基流动 / 本地 vLLM…），
# 只要改 config/sources.yaml 里的 base_url 和 model 即可。
# 本项目实测 deepseek-flash，一批约 7 万 token 输入，高峰价约 ¥0.2/天。
#
# 不填会怎样：llm.enabled 自动失效，降级成纯规则版——
#             素材卡少几张，「今日可用文案」栏不出现。其余功能不受影响。
RADAR_LLM_KEY=

# ---- SandBase：读抖音视频的真实配乐（可选）------------------------------
# 注册：https://api.sandbase.ai
# 免费额度 100 次/天，$0.001/次。项目默认每天最多用 60 次（config 里 daily_budget）。
#
# 不填会怎样：素材卡没有「配乐」字段，挑战类卡会缺 BGM 线索。
#             其余判定逻辑不变。
SANDBASE_API_KEY=

# 仅两个 probe 脚本会读这个变量；主流程读 config/sources.yaml 的 bgm_sampler.base_url
# SANDBASE_BASE_URL=https://api.sandbase.ai

# ---- 邮件投递（可选，QQ 邮箱）------------------------------------------
# 不填会怎样：只生成 Markdown 日报，不发邮件（产物照样在 sandbox/runs/<ts>/）。
#
# SMTP_PASS 是「授权码」，不是 QQ 登录密码：
#   mail.qq.com -> 设置 -> 账号与安全 -> 开启 POP3/IMAP/SMTP 服务
#   -> 短信验证 -> 得到 16 位授权码
# 服务器参数在 config/sources.yaml（smtp.qq.com:465，SSL）。
#
# 填错会报 535 Authentication failed。
SMTP_USER=
SMTP_PASS=
# 可选；不填则发给 SMTP_USER（发给自己）
SMTP_TO=
